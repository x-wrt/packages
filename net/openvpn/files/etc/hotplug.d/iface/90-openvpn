#!/bin/sh

# WAN address/gateway changes can arrive without a link-down dependency event.
openvpn_wan_update() (
	[ "$ACTION" = ifupdate ] || return 0
	[ "$IFUPDATE_ADDRESSES" = 1 ] || [ "$IFUPDATE_ROUTES" = 1 ] || return 0
	[ -n "$INTERFACE" ] || return 0
	local state interface
	for state in /var/run/openvpn-*; do
		[ -d "$state" ] && [ ! -e "$state/stopping" ] || continue
		grep -qxF "$INTERFACE" "$state/dependencies" 2>/dev/null || continue
		interface="${state#/var/run/openvpn-}"
		[ "$interface" != "$INTERFACE" ] || continue
		/usr/libexec/openvpn-hotplug wan-update "$interface"
	done
)

openvpn_wan_update
